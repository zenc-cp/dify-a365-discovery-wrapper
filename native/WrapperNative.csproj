<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CliPackage Condition="'$(CliPackage)' == ''">$(MSBuildProjectDirectory)/../.tools/a365/.store/microsoft.agents.a365.devtools.cli/1.1.221/microsoft.agents.a365.devtools.cli/1.1.221/tools/net8.0/any</CliPackage>
  </PropertyGroup>
  <Target Name="RequirePinnedCli" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CliPackage)/Microsoft.Agents.A365.DevTools.Cli.dll')" Text="Install the pinned public CLI 1.1.221 as documented, then run python lab.py build." />
  </Target>
  <ItemGroup>
    <Reference Include="Microsoft.Agents.A365.DevTools.Cli"><HintPath>$(CliPackage)/Microsoft.Agents.A365.DevTools.Cli.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(CliPackage)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
    <Reference Include="System.Text.Json"><HintPath>$(CliPackage)/System.Text.Json.dll</HintPath></Reference>
    <Reference Include="System.Text.Encodings.Web"><HintPath>$(CliPackage)/System.Text.Encodings.Web.dll</HintPath></Reference>
    <Reference Include="System.Diagnostics.DiagnosticSource"><HintPath>$(CliPackage)/System.Diagnostics.DiagnosticSource.dll</HintPath></Reference>
  </ItemGroup>
</Project>
